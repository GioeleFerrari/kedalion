# Copia questo file in .env e compila i valori per abilitare il login con GitHub.
# Senza queste variabili l'app funziona comunque in modalità locale
# (pulsante "Continua senza account" nella schermata di login).

# Creata su https://github.com/settings/developers -> "New OAuth App"
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Porta del server (opzionale, default 3000)
# PORT=3000

# URL pubblico dell'app, usato per costruire il redirect OAuth
# (opzionale, di default usa l'host della richiesta in arrivo)
# APP_URL=http://localhost:3000
